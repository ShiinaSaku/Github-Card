{
  "name": "@shiinasaku/github-card",
  "version": "5.0.0",
  "description": "Beautiful GitHub stats SVG cards. Embed in README, use as API, or render programmatically.",
  "keywords": [
    "badge",
    "bun",
    "elysia",
    "github",
    "github-card",
    "github-stats",
    "profile-card",
    "readme",
    "stats",
    "svg"
  ],
  "homepage": "https://card.shiina.xyz",
  "bugs": {
    "url": "https://github.com/ShiinaSaku/Github-Card/issues"
  },
  "license": "MIT",
  "author": {
    "name": "saku shiina",
    "email": "saku@shiina.xyz",
    "url": "https://www.shiina.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiinaSaku/Github-Card.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/lib.mjs",
  "types": "./dist/lib.d.mts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.mts",
      "bun": "./src/lib.ts",
      "import": "./dist/lib.mjs",
      "default": "./dist/lib.mjs"
    },
    "./server": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "dev:server": "bun run --watch src/index.ts",
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "typecheck": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@elysia/cors": "^2.0.0-rc.1",
    "@elysia/openapi": "^2.0.0-rc.1",
    "@elysia/server-timing": "^2.0.0-rc.0",
    "culori": "^4.0.2",
    "elysia": "^2.0.0-rc.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.5",
    "@types/culori": "^4.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.5"
}
